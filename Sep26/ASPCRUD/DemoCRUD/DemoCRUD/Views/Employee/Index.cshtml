@model List<DemoCRUD.Models.Employee>
<h1> Employee List</h1>
<table class="table">
    <tr>
        <th>Name</th>
        <th>Email</th>
        <th>DateOfJoin</th>
        <th>Designation</th>
        <th>Salary</th>
    </tr>
    @foreach(var employee in Model)
    {
    <tr>
        <td>@employee.Name</td>
        <td>@employee.Email</td>
        <td>@employee.DateOfJoin</td>
        <td>@employee.Designation</td>
        <td>@employee.Salary</td>
    </tr>
    }
    </table>